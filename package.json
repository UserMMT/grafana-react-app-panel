{
  "name": "grafana-react-app-panel",
  "version": "1.0.0",
  "description": "Generic Grafana panel plugin for embedding full React applications with backend SQL queries",
  "type": "module",
  "scripts": {
    "dev": "grafana-toolkit plugin:dev",
    "build": "grafana-toolkit plugin:build",
