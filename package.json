{
  "name": "grafana-react-app-panel",
  "version": "1.0.0",
  "description": "Generic Grafana panel plugin for embedding full React applications with backend SQL queries",
  "scripts": {
    "dev": "webpack -w -c ./webpack.config.ts --mode development",
    "build": "webpack -c ./webpack.config.ts --mode production",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "sucrase": "^3.35.0"
  },
  "devDependencies": {
    "@grafana/data": "^11.4.0",
    "@grafana/runtime": "^11.4.0",
    "@grafana/tsconfig": "^2.0.0",
    "@grafana/ui": "^11.4.0",
    "@swc/core": "^1.7.39",
    "@swc/jest": "^0.2.39",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-is": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}
